VITE_DATA_SOURCE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_ASSISTANT_ENABLED=false
VITE_ORCHESTRATOR_BASE_URL=http://localhost:8787
# Thumbnail generation (planned OpenRouter image model wiring)
# Keep this app on OpenRouter; use a dedicated image model for proposal thumbnails.
VITE_THUMBNAIL_PROVIDER=openrouter
VITE_THUMBNAIL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VITE_THUMBNAIL_OPENROUTER_API_KEY=
VITE_THUMBNAIL_OPENROUTER_MODEL=google/gemini-3.1-flash-image-preview

# Dev orchestrator (server/dev-orchestrator.mjs)
AI_ORCHESTRATOR_PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: separate OpenRouter image model for server-side thumbnail generation later
OPENROUTER_THUMBNAIL_MODEL=google/gemini-3.1-flash-image-preview
